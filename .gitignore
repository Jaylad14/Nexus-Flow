# Dependencies — reinstalled via npm install, never committed
node_modules/

# Environment secrets — API keys, DB passwords
.env
.env.local
.env.*.local

# Build output — regenerated by build tools
build/
dist/

# OS junk files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Editor folders
.vscode/*
!.vscode/settings.json